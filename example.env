# Copy to .env next to docker-compose.yml and adjust. Never commit .env.
# Tokens do NOT go here: put them in secrets/telegram_bot_token.txt and
# secrets/mono_token.txt (see README). TELEGRAM_BOT_TOKEN / MONO_TOKEN env vars
# also work, but are visible to anyone who can run `docker inspect`.

# Your Telegram user id(s), comma-separated. Everyone else is ignored.
ALLOWED_USER_IDS=123456789

# Run the container as your NAS user (SSH: `id`), so ./data belongs to you.
PUID=1000
PGID=1000

# Budget
WEEKLY_LIMIT=200
WEEK_START=monday
TIMEZONE=Europe/Madrid
LANGUAGE=uk

# Monobank accounts to count (empty = all EUR accounts)
ACCOUNT_IDS=

# What not to count
EXCLUDE_OWN_TRANSFERS=true
# OWN_TRANSFER_PATTERNS=обмін валют;конвертація;на банку
EXCLUDED_MCC=
EXCLUDED_DESCRIPTIONS=
REFUNDS_REDUCE_SPENDING=true

# Notifications
WARN_PCT=75
NOTIFY_EACH_EXPENSE=true
REPORT_ON_PERIOD_END=false

# Monobank polling interval in minutes (Monobank allows 1 request per minute)
POLL_MINUTES=5

LOG_LEVEL=INFO
